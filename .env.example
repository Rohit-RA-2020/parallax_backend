# HTTP
PARALLAX_ADDR=:8080

# Local media sandbox (ffmpeg may only read/write here)
PARALLAX_WORKSPACE=./workspace

# Last selected model id is persisted here (gitignored)
PARALLAX_DATA=./data

# Resumable large-file uploads (64 GiB per file by default)
PARALLAX_MAX_UPLOAD_BYTES=68719476736
PARALLAX_UPLOAD_EXPIRY_HOURS=24
PARALLAX_UPLOAD_STATUS_RETENTION_HOURS=168
PARALLAX_MAX_ACTIVE_UPLOADS=8
PARALLAX_MAX_PROJECT_UPLOADS=4

# Director YouTube import limits (download_youtube_video)
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=1800
YOUTUBE_MAX_DOWNLOAD_BYTES=8589934592
# YTDLP_BIN=./scripts/.venv/bin/yt-dlp

# Comma-separated provider IDs. Each provider reads LLM_<ID>_* vars below.
# Use LLM_<ID>_MODELS for every model available through the provider's
# endpoint/API key. The editor first selects the provider, then one of its models.
#   xAI:        https://api.x.ai/v1              grok-4.6
#   OpenAI:     https://api.openai.com/v1        gpt-4.1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai  gemini-3-flash-preview
#   Groq:       https://api.groq.com/openai/v1   llama-3.3-70b-versatile
#   Together:   https://api.together.xyz/v1      ...
#   OpenRouter: https://openrouter.ai/api/v1     ...
#   Ollama:     http://127.0.0.1:11434/v1        llama3.1
LLM_MODELS=grok,openai

LLM_GROK_LABEL=Grok
LLM_GROK_BASE_URL=https://api.x.ai/v1
LLM_GROK_MODELS=grok-4.6,grok-4-fast
LLM_GROK_API_KEY=

LLM_OPENAI_LABEL=OpenAI
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_MODELS=gpt-4.1,gpt-4o,o3
LLM_OPENAI_API_KEY=

# LLM_<ID>_MODEL remains supported for a provider with only one model.
# LLM_OPENAI_MODEL=gpt-4.1

# Single-model fallback when LLM_MODELS is unset:
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.6
# LLM_MODEL_LIST=grok-4.6,grok-4-fast
# LLM_API_KEY=
# XAI_API_KEY=

# Agent loop
PARALLAX_MAX_ITERS=12
# Maximum independent asset-generation calls run at once per Agent turn.
PARALLAX_MAX_PARALLEL_TOOLS=4

# Optional live web search for Director (Exa)
EXA_API_KEY=
# EXA_BASE_URL=https://api.exa.ai

# Unified GIF search/import for people and Director. Configure either or both;
# results are blended automatically and API keys stay on the server.
GIPHY_API_KEY=
KLIPY_API_KEY=
# GIPHY_API_BASE=https://api.giphy.com
# KLIPY_API_BASE=https://api.klipy.com

# Optional Gemini image generation for Director (generate_image)
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_MUSIC_MODEL=lyria-3-pro-preview
# GEMINI_MUSIC_OUTPUT_FORMAT=mp3
# GEMINI_OMNI_VIDEO_MODEL=gemini-omni-flash-preview
# GEMINI_VEO_VIDEO_MODEL=veo-3.1-generate-preview
# GEMINI_VIDEO_TIMEOUT_SECONDS=900
# GEMINI_VIDEO_POLL_SECONDS=5

# Optional ElevenLabs audio generation for Director
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ELEVENLABS_TTS_MODEL=eleven_v3
# ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v2
# ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_SFX_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_TTS_VOICES_FILE=./data/elevenlabs-voices.json
# ELEVENLABS_REQUEST_TIMEOUT_SECONDS=900
# ELEVENLABS_MAX_CONCURRENCY=4
# ELEVENLABS_MAX_RESPONSE_BYTES=268435456

# Optional binary overrides
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# GPU encode: auto (default) uses the first backend that actually works
# (cuda/nvenc, videotoolbox, qsv, vaapi). Set off to force libx264.
# FFMPEG_HWACCEL=auto
# Optional GPU index (cuda) or render node (vaapi), e.g. 0 or /dev/dri/renderD128
# FFMPEG_HWDEVICE=

# faster-whisper sidecar (./scripts/setup-whisper.sh)
WHISPER_PYTHON=./scripts/.venv/bin/python
WHISPER_SCRIPT=./scripts/transcribe.py
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8

# Separate OpenAI-compatible embeddings endpoint (do not reuse LLM_*).
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# Local Qdrant (one collection per project)
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
